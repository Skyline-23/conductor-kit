{
  "defaults": {
    "idle_timeout_ms": 120000,
    "summary_only": true,
    "max_parallel": 4
  },
  "runtime": {
    "transport": {
      "mode": "direct",
      "preferred": ["stdio", "unix_socket"],
      "allow_tmux_fallback": false
    },
    "loop": {
      "persist_runs": true,
      "resume_strategy": "ledger"
    },
    "memory": {
      "enabled": true,
      "ttl_hours": 24,
      "invalidate_on_git_head_change": true
    },
    "workers": {
      "max_workers": 4,
      "spawn_policy": "ephemeral",
      "continue_policy": "resume_when_possible"
    }
  },
  "workers": {
    "orchestrator": {
      "cli": "codex",
      "model": "gpt-5.4",
      "reasoning": "medium",
      "description": "Top-level coordinator for orchestration loops",
      "delivery_mode": "oneshot",
      "launch_mode": "argv_prompt",
      "base_args": [
        "exec",
        "--skip-git-repo-check",
        "--json",
        "--color",
        "never",
        "--dangerously-bypass-approvals-and-sandbox",
        "-m",
        "{model}"
      ]
    },
    "worker": {
      "cli": "claude",
      "model": "claude-sonnet-4-6",
      "description": "General worker process for fan-out tasks using Claude Code",
      "delivery_mode": "oneshot",
      "launch_mode": "argv_prompt",
      "base_args": [
        "--output-format",
        "json",
        "--permission-mode",
        "acceptEdits",
        "-p"
      ]
    },
    "verifier": {
      "cli": "claude",
      "model": "claude-sonnet-4-6",
      "description": "Verification worker for fan-out result review using Claude Code",
      "delivery_mode": "oneshot",
      "launch_mode": "argv_prompt",
      "base_args": [
        "--output-format",
        "json",
        "--permission-mode",
        "acceptEdits",
        "-p"
      ]
    }
  }
}
