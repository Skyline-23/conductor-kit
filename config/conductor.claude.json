{
  "defaults": {
    "idle_timeout_ms": 120000,
    "summary_only": true,
    "max_parallel": 4
  },
  "surface": {
    "cli": "claude",
    "description": "Primary operator surface following the user's host defaults",
    "base_args": []
  },
  "runtime": {
    "transport": {
      "mode": "direct",
      "preferred": ["stdio", "unix_socket"],
      "allow_tmux_fallback": false
    },
    "loop": {
      "persist_runs": true,
      "resume_strategy": "ledger"
    },
    "memory": {
      "enabled": true,
      "ttl_hours": 24,
      "invalidate_on_git_head_change": true
    },
    "workers": {
      "max_workers": 6,
      "spawn_policy": "persistent",
      "continue_policy": "resume_when_possible"
    }
  },
  "workers": {
    "explore": {
      "cli": "claude",
      "model": "claude-sonnet-4-6",
      "reasoning": "low",
      "description": "Fast codebase exploration and triage lane",
      "delivery_mode": "session",
      "launch_mode": "stdin_text",
      "base_args": [
        "--permission-mode",
        "acceptEdits",
        "--model",
        "{model}"
      ]
    },
    "build": {
      "cli": "claude",
      "model": "claude-sonnet-4-6",
      "reasoning": "high",
      "description": "Primary implementation lane",
      "delivery_mode": "session",
      "launch_mode": "stdin_text",
      "base_args": [
        "--permission-mode",
        "acceptEdits",
        "--model",
        "{model}"
      ]
    },
    "review": {
      "cli": "claude",
      "model": "claude-sonnet-4-6",
      "reasoning": "medium",
      "description": "Review and challenge lane",
      "delivery_mode": "session",
      "launch_mode": "stdin_text",
      "base_args": [
        "--permission-mode",
        "acceptEdits",
        "--model",
        "{model}"
      ]
    },
    "verify": {
      "cli": "claude",
      "model": "claude-sonnet-4-6",
      "reasoning": "high",
      "description": "Verification and completion evidence lane",
      "delivery_mode": "session",
      "launch_mode": "stdin_text",
      "base_args": [
        "--permission-mode",
        "acceptEdits",
        "--model",
        "{model}"
      ]
    }
  }
}
