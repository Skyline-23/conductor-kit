{
  "defaults": {
    "idle_timeout_ms": 120000,
    "summary_only": true,
    "max_parallel": 4
  },
  "runtime": {
    "transport": {
      "mode": "direct",
      "preferred": ["stdio", "unix_socket"],
      "allow_tmux_fallback": false
    },
    "loop": {
      "persist_runs": true,
      "resume_strategy": "ledger"
    },
    "memory": {
      "enabled": true,
      "ttl_hours": 24,
      "invalidate_on_git_head_change": true
    },
    "workers": {
      "max_workers": 4,
      "spawn_policy": "persistent",
      "continue_policy": "resume_when_possible"
    }
  },
  "workers": {
    "orchestrator": {
      "cli": "codex",
      "model": "host-default",
      "description": "Top-level Codex coordinator using the user's existing Codex settings",
      "delivery_mode": "session",
      "launch_mode": "stdin_text",
      "base_args": []
    },
    "worker": {
      "cli": "codex",
      "model": "host-default",
      "description": "Default interactive Codex worker using the user's existing Codex settings",
      "delivery_mode": "session",
      "launch_mode": "stdin_text",
      "base_args": []
    },
    "gemini_worker": {
      "cli": "gemini",
      "model": "gemini-2.5-flash",
      "description": "Optional interactive Gemini worker",
      "delivery_mode": "session",
      "launch_mode": "stdin_text",
      "base_args": [
        "-m",
        "{model}",
        "--yolo"
      ]
    },
    "claude_worker": {
      "cli": "claude",
      "model": "claude-sonnet-4-6",
      "description": "General worker process for fan-out tasks using Claude Code",
      "delivery_mode": "session",
      "launch_mode": "stdin_text",
      "base_args": [
        "--permission-mode",
        "acceptEdits",
        "--model",
        "{model}"
      ]
    },
    "verifier": {
      "cli": "codex",
      "model": "host-default",
      "description": "Verification worker using the user's existing Codex settings",
      "delivery_mode": "session",
      "launch_mode": "stdin_text",
      "base_args": []
    }
  }
}
