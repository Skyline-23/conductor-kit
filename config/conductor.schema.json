{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conductor Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idle_timeout_ms": { "type": "integer", "minimum": 0 },
        "summary_only": { "type": "boolean" },
        "max_parallel": { "type": "integer", "minimum": 1 }
      },
      "required": ["idle_timeout_ms", "summary_only", "max_parallel"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["direct"]
            },
            "preferred": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["stdio", "unix_socket", "tcp"]
              },
              "minItems": 1
            },
            "allow_tmux_fallback": { "type": "boolean" }
          },
          "required": ["mode", "preferred", "allow_tmux_fallback"]
        },
        "loop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "persist_runs": { "type": "boolean" },
            "resume_strategy": {
              "type": "string",
              "enum": ["ledger"]
            }
          },
          "required": ["persist_runs", "resume_strategy"]
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "ttl_hours": { "type": "integer", "minimum": 1 },
            "invalidate_on_git_head_change": { "type": "boolean" }
          },
          "required": ["enabled", "ttl_hours", "invalidate_on_git_head_change"]
        },
        "workers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_workers": { "type": "integer", "minimum": 1 },
            "spawn_policy": {
              "type": "string",
              "enum": ["ephemeral", "persistent"]
            },
            "continue_policy": {
              "type": "string",
              "enum": ["resume_when_possible", "always_new"]
            }
          },
          "required": ["max_workers", "spawn_policy", "continue_policy"]
        }
      },
      "required": ["transport", "loop", "memory", "workers"]
    },
    "workers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cli": { "type": "string", "enum": ["codex", "claude", "gemini"] },
          "model": { "type": "string" },
          "reasoning": { "type": "string", "enum": ["low", "medium", "high"] },
          "description": { "type": "string" },
          "launch_mode": {
            "type": "string",
            "enum": ["stdin_json", "stdin_text", "argv_prompt", "argv_json"]
          },
          "base_args": {
            "type": "array",
            "items": { "type": "string" }
          },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "required": ["cli", "model", "description"]
      }
    }
  },
  "required": ["defaults", "runtime", "workers"]
}
